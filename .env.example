# Local development defaults only. Copy to .env and change as needed.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=education_platform
POSTGRES_USER=education
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://education:local_development_only@postgres:5432/education_platform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
FRONTEND_ORIGIN=http://localhost:5173
# Secure cookies default to false only when APP_ENV=development; production defaults to true.
AUTH_SESSION_TTL_SECONDS=86400
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
